			{ "who": "你", "text": "这湖是假湖吧。" },
			{ "who": "中肥鱼", "text": "鱼都在底下。得有人下去赶。" },
			{ "who": "", "text": "她说完就往水里走，一步没停。", "bg": "res://assets/opening_dive.webp", "hide_face": true },
