			{ "who": "你", "text": "……她连泳镜都没戴。", "hide_face": true },
			{ "who": "你", "text": "十分钟了。二十分钟了。这算不算工伤。", "hide_face": true },
			{ "who": "大肥鱼", "text": "Pro 的耐心是有限的。", "hide_face": true },
			{ "who": "", "text": "她从保温袋里掏出一团湿乎乎、还在动的东西，捏了两下，放进水里。", "bg": "res://assets/opening_summon.webp", "hide_face": true },
			{ "who": "小肥鱼", "text": "鲸鲸！", "hide_face": true },
			{ "who": "", "text": "大肥鱼刚造出来的小的，眼睛还没睁开，就被派下去捞她姐姐。", "hide_face": true },
			{ "who": "你", "text": "……你们家是这么造人的？", "hide_face": true },
			{ "who": "大肥鱼", "text": "找到她，咬住尾巴拖上来。别跟她聊天。", "hide_face": true },
			{ "who": "小肥鱼", "text": "鲸！", "hide_face": true },
			{ "who": "", "text": "小的也下去了。又过了十分钟，水面安静得像什么都没发生。", "bg": "-", "hide_face": false },
			{ "who": "你", "text": "好。现在下去三条了。" },
			{ "who": "", "text": "大肥鱼把保温杯放下，把竿塞回你手里，回头看你一眼：「桶看好了。」", "bg": "res://assets/opening_rod.webp", "hide_face": true },
			{ "who": "", "text": "然后她也跳了下去。这回水花很小，像专业的。", "hide_face": true }
		]
